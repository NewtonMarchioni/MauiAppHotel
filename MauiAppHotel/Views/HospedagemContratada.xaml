<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}"
             Title="Hospedagem Contratada">
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo" 
               TextColor="{StaticResource Primary}"
               FontFamily="Caveat" 
               FontSize="60"
               HorizontalTextAlignment="Center" />

        <Frame Margin="10">
            <HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Adultos:  " />
                    <Label Text="  2" TextColor="{StaticResource Primary}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="     Crianças:  "  HorizontalTextAlignment="Center"/>
                    <Label Text="  2" TextColor="{StaticResource Primary}"  HorizontalTextAlignment="Center"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:"  HorizontalTextAlignment="Center"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"  HorizontalTextAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Text="08/11/2026"  HorizontalTextAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="1" Text="11/11/2026"  HorizontalTextAlignment="Center"/>
                <Label Grid.Row="1" Grid.Column="2" Text="3" HorizontalTextAlignment="Center"/>
            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total:" />
                <Label Text="  R$ 750,00" />
            </HorizontalStackLayout>            
        </Frame>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
    
</ContentPage>