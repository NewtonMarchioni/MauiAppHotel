<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="15"
                             Spacing="12">

            <Label Text="Reserva Confirmada"
                   FontFamily="CaveatSemiBold"
                   FontSize="44"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="15"
                   CornerRadius="10">
                <VerticalStackLayout Spacing="8">

                    <!-- Dados da Suíte -->
                    <Label Text="Acomodação Escolhida:"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />
                    <Label Text="{Binding QuartoSelecionado.Descricao}"
                           FontSize="16"
                           TextColor="{StaticResource Primary}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                    <!-- Hóspedes -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding QntAdultos}" HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding QntCriancas}" HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                    <!-- Período e Diárias -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" 
                               Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" 
                               HorizontalOptions="End" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" 
                               Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" 
                               HorizontalOptions="End" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Total de diárias:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" 
                               Text="{Binding Estadia, StringFormat='{0} dia(s)'}" 
                               HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />

                    <!-- Valor Final Calculado -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,6,0,0">
                        <Label Text="Total a Pagar:"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="DarkGreen"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Nova Reserva"
                    Clicked="Button_Voltar_Clicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,5,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>