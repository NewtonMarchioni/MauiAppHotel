<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">


    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Cálculo da Diária"
            FontFamily="CaveatSemiBold"
            TextColor="{StaticResource Primary}"
            FontSize="44"
            HorizontalOptions="Center"/>

        <Frame Padding="10">
            <VerticalStackLayout>
                <Frame>
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *, 2*">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:" FontAttributes="Bold" />

                        <Label Grid.Row="0" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}" />

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}" />

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>
                </Frame>

                <Frame>
                    <VerticalStackLayout>
                        <Label Text="Escolha sua Suíte" FontAttributes="Bold"/>

                        <Label Text="Selecione sua Acomodação"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               Margin="0,5,0,2" />

                        <Picker x:Name="pck_quarto"
                                ItemDisplayBinding="{Binding DescricaoCompleta}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="10"
                       Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Período da Estadia" FontAttributes="Bold"/>
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" FontAttributes="Bold"/>
                            <DatePicker x:Name="dtpck_checkin"
                                        TextColor="{StaticResource Primary}"
                                        Format="dd/MM/yyyy"
                                        DateSelected="dtpck_checkin_DateSelected" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out:" FontAttributes="Bold"/>
                            <DatePicker x:Name="dtpck_checkout"
                                   TextColor="Crimson"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar"
                        Clicked="Button_Clicked" 
                        HorizontalOptions="Center" />

                <Label Text="Sobre o app"
                       TextColor="{StaticResource Primary}"
                       
                       TextDecorations="None"
                       HorizontalOptions="End"
                       Margin="0,8,0,0">    
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Sobre_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>