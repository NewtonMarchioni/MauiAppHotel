<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label Text="Cálculo da Diária"
               FontFamily="CaveatSemiBold"
               TextColor="{StaticResource Primary}"
               FontSize="44"
               HorizontalOptions="Center" />

        <Frame Padding="10">
            <VerticalStackLayout Spacing="8">

                <!-- Quantidade de Hóspedes -->
                <Frame Padding="10">
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *, 2*"
                          RowSpacing="6">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <Label Grid.Row="0" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}"
                               VerticalOptions="Center" />

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <Label Grid.Row="1" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}"
                               VerticalOptions="Center" />

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>
                </Frame>

                <!-- Seleção da Acomodação -->
                <Frame Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Acomodação"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <Picker x:Name="pck_quarto"
                                Title="Selecione sua Suíte"
                                ItemDisplayBinding="{Binding Descricao}"
                                SelectedIndexChanged="pck_quarto_SelectedIndexChanged" />

                        <!-- Exibe os valores da suíte selecionada -->
                        <Label x:Name="lbl_valores_quarto"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Período da Estadia (Alinhamento em Grid) -->
                <Frame Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Período da Estadia"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <Grid ColumnDefinitions="Auto, *"
                              RowDefinitions="Auto, Auto"
                              RowSpacing="8"
                              ColumnSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Check-in:"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <DatePicker Grid.Row="0" Grid.Column="1"
                                        x:Name="dtpck_checkin"
                                        TextColor="{StaticResource Primary}"
                                        Format="dd/MM/yyyy"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        HorizontalOptions="FillAndExpand" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Check-out:"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        x:Name="dtpck_checkout"
                                        TextColor="Crimson"
                                        Format="dd/MM/yyyy"
                                        HorizontalOptions="FillAndExpand" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar"
                        Clicked="Button_Clicked"
                        HorizontalOptions="Center"
                        Margin="0,4,0,0" />

                <Label Text="Sobre o app"
                       TextColor="{StaticResource Primary}"
                       TextDecorations="None"
                       HorizontalOptions="End"
                       Margin="0,4,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Sobre_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>